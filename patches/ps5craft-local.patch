+        if (writeEnd && endptr != 0)
+            _ = TryWriteUInt64Compat(ctx, endptr, any ? cursor : ctx[CpuRegister.Rdi]);
+        ctx[CpuRegister.Rax] = any
+            ? (unsigned && negative ? unchecked(0UL - magnitude) : magnitude)
+            : 0;
+        return (int)OrbisGen2Result.ORBIS_GEN2_OK;
+    }
+
+    private static bool TryReadGuestByte(CpuContext ctx, ulong address, Span<byte> one, out byte value)
+    {
+        value = 0;
+        if (!TryReadCompat(ctx, address, one))
+            return false;
+        value = one[0];
+        return true;
+    }
+
+    private static bool IsAsciiSpace(byte value) =>
+        value is 0x20 or 0x09 or 0x0A or 0x0B or 0x0C or 0x0D;
+
+    [SysAbiExport(
+        Nid = "DFmMT80xcNI",
+        ExportName = "sysctl",
+        Target = Generation.Gen4 | Generation.Gen5,
+        LibraryName = "libKernel")]
+    public static int KernelSysctl(CpuContext ctx)
+    {
+        var name = ctx[CpuRegister.Rdi];
+        var nameLen = ctx[CpuRegister.Rsi];
+        var oldp = ctx[CpuRegister.Rdx];
+        var oldlenp = ctx[CpuRegister.Rcx];
+        if (nameLen < 2 ||
+            !TryReadUInt32Compat(ctx, name, out var name0) ||
+            !TryReadUInt32Compat(ctx, name + 4, out var name1) ||
+            !TryReadUInt64Compat(ctx, oldlenp, out var oldLen))
+        {
+            ctx[CpuRegister.Rax] = unchecked((ulong)-1);
+            return -1;
+        }
+
+        ulong value = 0;
+        ulong valueSize = oldLen;
+        switch (((ulong)name0 << 32) | name1)
+        {
+            case 0x0000000300000006UL: // CTL_HW/HW_NCPU
+                if (oldLen < 4)
+                {
+                    ctx[CpuRegister.Rax] = unchecked((ulong)-1);
+                    return -1;
+                }
+                value = 8;
+                valueSize = 4;
+                _ = TryWriteUInt32Compat(ctx, oldp, (uint)value);
+                break;
+            case 0x0000000500000006UL: // CTL_HW/HW_PHYSMEM
+                if (oldLen < 8)
+                {
+                    ctx[CpuRegister.Rax] = unchecked((ulong)-1);
+                    return -1;
+                }
+                value = 8UL * 1024 * 1024 * 1024;
+                valueSize = 8;
+                _ = TryWriteUInt64Compat(ctx, oldp, value);
+                break;
+            default:
+                ctx[CpuRegister.Rax] = unchecked((ulong)-1);
+                return -1;
+        }
+
+        _ = TryWriteUInt64Compat(ctx, oldlenp, valueSize);
+        ctx[CpuRegister.Rax] = 0;
+        return (int)OrbisGen2Result.ORBIS_GEN2_OK;
+    }
 }
